<Window x:Class="LiveTranslator.App.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Live Translator"
        Width="760" Height="340" MinWidth="440" MinHeight="180"
        Background="{StaticResource Bg}" Foreground="{StaticResource Fg}"
        FontFamily="{StaticResource UiFont}"
        WindowStyle="None" ResizeMode="CanResize"
        UseLayoutRounding="True" TextOptions.TextFormattingMode="Display">

    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="36" ResizeBorderThickness="6" GlassFrameThickness="0" CornerRadius="0" UseAeroCaptionButtons="False" />
    </WindowChrome.WindowChrome>

    <Border BorderBrush="{StaticResource Line}" BorderThickness="1">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="36" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- Title bar -->
            <DockPanel Grid.Row="0" Background="{StaticResource BgElevated}">
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" WindowChrome.IsHitTestVisibleInChrome="True">
                    <Button x:Name="RunButton" Style="{StaticResource ChromeButton}" Click="Run_Click" ToolTip="暂停" AutomationProperties.Name="暂停">
                        <TextBlock x:Name="RunGlyph" Text="&#xE769;" />
                    </Button>
                    <ToggleButton x:Name="OverlayButton" Style="{StaticResource ChromeButton}" Content="&#xE8A7;"
                                  Checked="Overlay_Changed" Unchecked="Overlay_Changed" ToolTip="悬浮字幕（右键更多选项）" AutomationProperties.Name="悬浮字幕（右键更多选项）">
                        <ToggleButton.ContextMenu>
                            <ContextMenu>
                                <MenuItem x:Name="ClickThroughItem" Header="鼠标穿透（锁定悬浮字幕）" IsCheckable="True" Click="ClickThrough_Click" />
                            </ContextMenu>
                        </ToggleButton.ContextMenu>
                    </ToggleButton>
                    <ToggleButton x:Name="TopmostButton" Style="{StaticResource ChromeButton}" Content="&#xE718;"
                                  Checked="Topmost_Changed" Unchecked="Topmost_Changed" ToolTip="窗口置顶" AutomationProperties.Name="窗口置顶" />
                    <Button Style="{StaticResource ChromeButton}" Content="&#xE894;" Click="Clear_Click" ToolTip="清空记录" AutomationProperties.Name="清空记录" />
                    <Button x:Name="SettingsButton" Style="{StaticResource ChromeButton}" Content="&#xE713;" Click="Settings_Click" ToolTip="设置" AutomationProperties.Name="设置" />
                    <Button Style="{StaticResource ChromeButton}" Content="&#xE921;" FontSize="10" Click="Minimize_Click" ToolTip="最小化" AutomationProperties.Name="最小化" />
                    <Button Style="{StaticResource CloseButton}" Content="&#xE8BB;" FontSize="10" Click="Close_Click" ToolTip="退出" AutomationProperties.Name="退出" />
                </StackPanel>

                <StackPanel Orientation="Horizontal" Margin="12,0,0,0" VerticalAlignment="Center">
                    <Ellipse x:Name="StatusDot" Width="8" Height="8" Fill="{StaticResource FgMuted}" VerticalAlignment="Center" />
                    <TextBlock Text="Live Translator" FontWeight="SemiBold" FontSize="13" Margin="8,0,4,0" VerticalAlignment="Center" />
                    <Button x:Name="ProviderButton" Style="{StaticResource PillButton}" Click="ProviderButton_Click"
                            WindowChrome.IsHitTestVisibleInChrome="True" ToolTip="切换翻译服务" AutomationProperties.Name="切换翻译服务">
                        <TextBlock Text="{Binding ProviderName}" MaxWidth="220" TextTrimming="CharacterEllipsis" />
                    </Button>
                    <Button x:Name="LanguageButton" Style="{StaticResource PillButton}" Click="LanguageButton_Click"
                            WindowChrome.IsHitTestVisibleInChrome="True" ToolTip="切换目标语言" AutomationProperties.Name="切换目标语言">
                        <TextBlock>
                            <Run Text="→" Foreground="{StaticResource FgMuted}" />
                            <Run Text="{Binding LanguageName, Mode=OneWay}" />
                        </TextBlock>
                    </Button>
                </StackPanel>
            </DockPanel>

            <!-- Transcript -->
            <ScrollViewer x:Name="Scroller" Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="16,8,10,8"
                          ScrollChanged="Scroller_ScrollChanged">
                <ScrollViewer.Resources>
                    <Style TargetType="ScrollBar" BasedOn="{StaticResource SlimScrollBar}" />
                </ScrollViewer.Resources>
                <StackPanel>
                    <TextBlock Foreground="{StaticResource FgMuted}" TextWrapping="Wrap" Margin="0,24,0,0" FontSize="13"
                               Visibility="{Binding IsEmpty, Converter={StaticResource BoolToVisibility}}">
                        等待语音…  播放任意有声音的视频、会议或直播即可开始实时翻译。<LineBreak />
                        也可以在右下角输入文字测试当前翻译服务。点击 ⚙ 添加 OpenAI、Claude、Gemini、DeepSeek、通义千问等大模型。
                    </TextBlock>

                    <ItemsControl ItemsSource="{Binding Entries}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Margin="0,4,0,10">
                                    <TextBlock Text="{Binding Source}" Foreground="{StaticResource FgMuted}" TextWrapping="Wrap"
                                               FontSize="{Binding DataContext.OriginalFontSize, RelativeSource={RelativeSource AncestorType=Window}}" />
                                    <DockPanel Margin="0,2,0,0">
                                        <TextBlock DockPanel.Dock="Right" Text="{Binding Latency}" Foreground="{StaticResource FgMuted}"
                                                   FontSize="11" Margin="12,0,0,3" VerticalAlignment="Bottom"
                                                   Visibility="{Binding DataContext.ShowLatency, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource BoolToVisibility}}" />
                                        <TextBlock Text="{Binding Translation}" TextWrapping="Wrap" Foreground="{StaticResource FgText}"
                                                   FontSize="{Binding DataContext.TranslationFontSize, RelativeSource={RelativeSource AncestorType=Window}}" />
                                    </DockPanel>
                                    <TextBlock Text="{Binding Error}" Foreground="{StaticResource Danger}" FontSize="12" TextWrapping="Wrap"
                                               Visibility="{Binding HasError, Converter={StaticResource BoolToVisibility}}" />
                                </StackPanel>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <!-- Sentence currently being spoken: styled exactly like finished ones so nothing jumps when it completes. -->
                    <StackPanel Margin="0,4,0,6" Visibility="{Binding HasPartial, Converter={StaticResource BoolToVisibility}}">
                        <TextBlock Text="{Binding PartialSource}" Foreground="{StaticResource FgMuted}" TextWrapping="Wrap"
                                   FontSize="{Binding OriginalFontSize}" />
                        <TextBlock Text="{Binding PartialTranslation}" Foreground="{StaticResource FgText}" TextWrapping="Wrap" Margin="0,2,0,0"
                                   FontSize="{Binding TranslationFontSize}" />
                    </StackPanel>
                </StackPanel>
            </ScrollViewer>

            <!-- Status bar -->
            <DockPanel Grid.Row="2" Background="{StaticResource BgElevated}" Height="34" LastChildFill="True">
                <TextBox x:Name="ManualInput" DockPanel.Dock="Right" Width="260" Margin="8,4" Style="{StaticResource InputBox}"
                         Tag="输入文字后按 Enter 翻译" KeyDown="ManualInput_KeyDown" />
                <TextBlock x:Name="StatusText" Text="{Binding Status}" Foreground="{StaticResource FgMuted}" FontSize="12"
                           VerticalAlignment="Center" Margin="12,0,0,0" TextTrimming="CharacterEllipsis" ToolTip="{Binding Status}" />
            </DockPanel>
        </Grid>
    </Border>
</Window>
