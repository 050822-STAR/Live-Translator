<Window x:Class="LiveTranslator.App.Views.OverlayWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Live Translator 悬浮字幕"
        Width="960" Height="170" MinWidth="300" MinHeight="70"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        Topmost="True" ShowInTaskbar="False" ResizeMode="CanResizeWithGrip"
        FontFamily="{StaticResource UiFont}" UseLayoutRounding="True"
        MouseLeftButtonDown="Window_MouseLeftButtonDown" MouseEnter="Window_MouseEnter" MouseLeave="Window_MouseLeave">
    <Grid>
        <Border x:Name="Backdrop" Background="Black" CornerRadius="10" Opacity="0.55" />

        <StackPanel VerticalAlignment="Bottom" Margin="20,12,20,14">
            <StackPanel.Effect>
                <DropShadowEffect BlurRadius="4" ShadowDepth="1" Opacity="0.9" Color="Black" RenderingBias="Performance" />
            </StackPanel.Effect>
            <TextBlock x:Name="OriginalText" Text="{Binding OverlayOriginal}" Foreground="#D0FFFFFF"
                       TextWrapping="Wrap" TextAlignment="Center" Margin="0,0,0,4" />
            <!-- Both translation lines share one style: a line only scrolls up, it never changes size or color. -->
            <TextBlock x:Name="PreviousText" Text="{Binding OverlayPrevious}" TextWrapping="Wrap" TextAlignment="Center" Margin="0,0,0,2" />
            <TextBlock x:Name="TranslationText" Text="{Binding OverlayTranslation}" TextWrapping="Wrap" TextAlignment="Center" />
        </StackPanel>

        <StackPanel x:Name="Controls" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Top"
                    Margin="0,4,6,0" Visibility="Hidden">
            <Button Style="{StaticResource ChromeButton}" Width="30" Height="28" Content="&#xE738;" Click="FontSmaller_Click" ToolTip="缩小字号" AutomationProperties.Name="缩小字号" />
            <Button Style="{StaticResource ChromeButton}" Width="30" Height="28" Content="&#xE710;" Click="FontLarger_Click" ToolTip="放大字号" AutomationProperties.Name="放大字号" />
            <ToggleButton x:Name="OriginalToggle" Style="{StaticResource ChromeButton}" Width="30" Height="28" Content="&#xE8D2;"
                          Checked="OriginalToggle_Changed" Unchecked="OriginalToggle_Changed" ToolTip="显示原文" AutomationProperties.Name="显示原文" />
            <Button Style="{StaticResource ChromeButton}" Width="30" Height="28" Content="&#xE72E;" Click="Lock_Click"
                    ToolTip="鼠标穿透（之后可在主窗口悬浮字幕按钮的右键菜单中解除）" AutomationProperties.Name="鼠标穿透（之后可在主窗口悬浮字幕按钮的右键菜单中解除）" />
            <Button Style="{StaticResource ChromeButton}" Width="30" Height="28" Content="&#xE8BB;" FontSize="10" Click="Close_Click" ToolTip="关闭悬浮字幕" AutomationProperties.Name="关闭悬浮字幕" />
        </StackPanel>
    </Grid>
</Window>
